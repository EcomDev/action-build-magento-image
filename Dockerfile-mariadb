# check=skip=SecretsUsedInArgOrEnv
ARG SOURCE_VERSION=11.8

FROM ghcr.io/wardenenv/mariadb:${SOURCE_VERSION} AS mariadb-setup

ENV MYSQL_DATABASE=magento \
    MYSQL_PASSWORD=magento \
    MYSQL_ROOT_PASSWORD=magento \
    MYSQL_USER=magento \
    MARIADB_INITDB_SKIP_TZINFO=1

COPY --from=scripts --chmod=0755 prepare-db-rootfs.sh /tmp/prepare-db-rootfs.sh
RUN ["/tmp/prepare-db-rootfs.sh", "mariadb"]

COPY *.sql* /docker-entrypoint-initdb.d/

RUN ["docker-entrypoint.sh", "mariadbd", "--datadir=/setup/db", "--innodb-fast-shutdown=0"]

FROM scratch

ENV PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    MYSQL_DATABASE=magento \
    MYSQL_PASSWORD=magento \
    MYSQL_ROOT_PASSWORD=magento \
    MYSQL_USER=magento

COPY --from=mariadb-setup /rootfs /
COPY --from=mariadb-setup --chown=mysql:mysql /setup/db /var/lib/mysql

USER mysql
EXPOSE 3306

ENTRYPOINT ["mariadbd"]