# check=skip=SecretsUsedInArgOrEnv
ARG SOURCE_VERSION=11.8

FROM ghcr.io/wardenenv/mariadb:${SOURCE_VERSION} AS mariadb-setup

ENV MYSQL_DATABASE=magento \
    MYSQL_PASSWORD=magento \
    MYSQL_ROOT_PASSWORD=magento \
    MYSQL_USER=magento

# Prevent executing server on build run
RUN ["sed", "-i", "s/exec \\\"$@\\\"/ /", "/usr/local/bin/docker-entrypoint.sh"]
RUN /usr/bin/install -m 0775 -o mysql -g root -d /setup/db
COPY *.sql* /docker-entrypoint-initdb.d/

RUN ["docker-entrypoint.sh", "mariadbd", "--datadir=/setup/db", "--max-allowed-packet=1024M"]

FROM ghcr.io/wardenenv/mariadb:${SOURCE_VERSION}

ENV MYSQL_DATABASE=magento \
    MYSQL_PASSWORD=magento \
    MYSQL_ROOT_PASSWORD=magento \
    MYSQL_USER=magento

COPY --from=mariadb-setup /setup/db /var/lib/mysql